import { ensurePrediction } from "../api/feed/service";
import { getDb } from "../api/queries/connection";
import { predictions, teams, teamRatings, events } from "./schema";
import { eq, inArray } from "drizzle-orm";
const ok = await ensurePrediction(30229, "TENNIS");
console.log("ensurePrediction:", ok);
const db = getDb();
const [p] = await db.select().from(predictions).where(eq(predictions.eventId, 30229)).limit(1);
console.log("prediction:", p.homeWinProb, p.projSpread, p.projTotal);
const [ev] = await db.select().from(events).where(eq(events.id, 30229)).limit(1);
const rows = await db.select().from(teamRatings).where(inArray(teamRatings.teamId, [ev.homeTeamId, ev.awayTeamId]));
for (const r of rows) console.log("rating row:", r.ratings);
process.exit(0);
